# Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use (free tier models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Cloud — set your cluster URL and API key
# Get these from your Qdrant Cloud dashboard: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# Collection name for vector RAG
QDRANT_COLLECTION=documents
